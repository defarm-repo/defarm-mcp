{
  "name": "@defarm/mcp",
  "version": "0.1.0-alpha.0",
  "description": "DeFarm MCP server — seal, open, verify and ingest verifiable agri-traceability data from an AI agent. The DeFarm server stays cryptographically blind to sealed fields; private keys never leave the local keystore; credentials never flow through the model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defarm-repo/defarm-mcp.git"
  },
  "type": "module",
  "bin": {
    "defarm-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@defarm/sdk": "github:defarm-repo/defarm-sdk-ts#3404ebaec4e834d74421c38a072e95088cdc06a8",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "defarm",
    "mcp",
    "model-context-protocol",
    "traceability",
    "hpke",
    "sealed-field"
  ]
}
